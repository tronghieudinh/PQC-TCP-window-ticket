#!/usr/bin/env bpftrace
/*
 * ticket_xmit.bt - when every segment of a connection is queued, leaves the queueing discipline and arrives, and when the server's writes
 * return, all on ONE clock (nsecs = CLOCK_MONOTONIC). With it the order of the server's own segments and of the client's segments can be
 * read without relating the capture clock to the kernel clock.
 *
 *   sudo bpftrace -q ticket_xmit.bt 4433 > tag.bpf.txt        ($1 = port of the server; trace_run.py starts it when PQC_BPF names this file)
 *
 * Output lines:
 *   XQ ns cpu sport dport seq len      a TCP segment of the connection is handed to the device queue (net_dev_queue: BEFORE the netem delay)
 *   XS ns cpu sport dport seq len      the same segment leaves the queueing discipline (net_dev_start_xmit: AFTER the delay; tcpdump stamps here)
 *   RX ns cpu sport dport seq ack len  a segment is queued to a CPU's input backlog on arrival (netif_rx; tcpdump stamps arrivals here)
 *   SEND ns tid dport write_seq_before write_seq_after   return of a tcp_sendmsg() call of the server (the bytes it wrote)
 * XS - XQ of a segment is the delay the device really added; because captured server-to-client packets are stamped at XS, the time the
 * server sent them is XQ, not "capture stamp - RTT/2". Only IPv6 TCP is matched (next header 6); headers are read through
 * skb->network_header. Check that the probe attaches on a new kernel with: python3 clock_sync.py --smoke
 */
BEGIN { printf("READY\n"); }

tracepoint:net:net_dev_queue
{
  $skb = (struct sk_buff *)args->skbaddr;
  $n = (uint8 *)($skb->head + $skb->network_header);
  if ((*$n >> 4) == 6 && *($n + 6) == 6) {
    $sp = ((uint16)*($n + 40) << 8) | (uint16)*($n + 41); $dp = ((uint16)*($n + 42) << 8) | (uint16)*($n + 43);
    if ($sp == $1 || $dp == $1) {
      $seq = ((uint32)*($n + 44) << 24) | ((uint32)*($n + 45) << 16) | ((uint32)*($n + 46) << 8) | (uint32)*($n + 47);
      $pl = (((uint16)*($n + 4) << 8) | (uint16)*($n + 5)) - ((*($n + 52) >> 4) * 4);
      printf("XQ %llu %d %u %u %u %u\n", nsecs, cpu, $sp, $dp, $seq, $pl);
    }
  }
}

tracepoint:net:net_dev_start_xmit
{
  $skb = (struct sk_buff *)args->skbaddr;
  $n = (uint8 *)($skb->head + $skb->network_header);
  if ((*$n >> 4) == 6 && *($n + 6) == 6) {
    $sp = ((uint16)*($n + 40) << 8) | (uint16)*($n + 41); $dp = ((uint16)*($n + 42) << 8) | (uint16)*($n + 43);
    if ($sp == $1 || $dp == $1) {
      $seq = ((uint32)*($n + 44) << 24) | ((uint32)*($n + 45) << 16) | ((uint32)*($n + 46) << 8) | (uint32)*($n + 47);
      $pl = (((uint16)*($n + 4) << 8) | (uint16)*($n + 5)) - ((*($n + 52) >> 4) * 4);
      printf("XS %llu %d %u %u %u %u\n", nsecs, cpu, $sp, $dp, $seq, $pl);
    }
  }
}

tracepoint:net:netif_rx
{
  $skb = (struct sk_buff *)args->skbaddr;
  $n = (uint8 *)($skb->head + $skb->network_header);
  if ((*$n >> 4) == 6 && *($n + 6) == 6) {
    $sp = ((uint16)*($n + 40) << 8) | (uint16)*($n + 41); $dp = ((uint16)*($n + 42) << 8) | (uint16)*($n + 43);
    if ($sp == $1 || $dp == $1) {
      $seq = ((uint32)*($n + 44) << 24) | ((uint32)*($n + 45) << 16) | ((uint32)*($n + 46) << 8) | (uint32)*($n + 47);
      $ack = ((uint32)*($n + 48) << 24) | ((uint32)*($n + 49) << 16) | ((uint32)*($n + 50) << 8) | (uint32)*($n + 51);
      $pl = (((uint16)*($n + 4) << 8) | (uint16)*($n + 5)) - ((*($n + 52) >> 4) * 4);
      printf("RX %llu %d %u %u %u %u %u\n", nsecs, cpu, $sp, $dp, $seq, $ack, $pl);
    }
  }
}

kprobe:tcp_sendmsg
{
  $sk = (struct sock *)arg0;
  if ($sk->__sk_common.skc_num == $1) { $tp = (struct tcp_sock *)arg0; @ssk[tid] = arg0; @sws[tid] = $tp->write_seq; }
}
kretprobe:tcp_sendmsg
/@ssk[tid] != 0/
{
  $sk = (struct sock *)@ssk[tid]; $tp = (struct tcp_sock *)@ssk[tid];
  printf("SEND %llu %d %u %u %u\n", nsecs, tid, bswap($sk->__sk_common.skc_dport), @sws[tid], $tp->write_seq);
  delete(@ssk[tid]); delete(@sws[tid]);
}
END { clear(@ssk); clear(@sws); }
