#!/usr/bin/env bpftrace
/*
 * WP6 part G1: are the ACKs of the session ticket deferred while the application owns the socket? (the open point of the Letter)
 *   sudo bpftrace -q ticket_backlog.bt 4433 > tag.bpf.txt          ($1 = local port of the server)
 * The server's tcp_sendmsg() takes the socket lock; ACKs that arrive meanwhile are queued by tcp_add_backlog() and processed by release_sock() -> __release_sock(), at the end of
 * tcp_sendmsg (still inside the call). Lines (nsecs is CLOCK_MONOTONIC; tid = CPU thread):
 *   SEND ns tid dport write_seq_before write_seq_after     at return of tcp_sendmsg (the bytes written by that call are (before, after])
 *   BKLG ns tid dport                                      at entry of tcp_add_backlog (an incoming segment found the socket owned by the user)
 *   RELS ns tid dport / RELE ns tid                        entry / return of __release_sock (the backlog is processed between the two)
 *   RENO ns tid dport ack acked cwnd ssthresh packets_out max_packets_out is_cwnd_limited   at entry of tcp_reno_cong_avoid (as in ticket_state.bt)
 *   SS   ns tid dport acked cwnd ssthresh                  at entry of tcp_slow_start
 * analyze_backlog.py joins them: a RENO event with the same tid between RELS and RELE was processed from the backlog.
 */
BEGIN { printf("READY\n"); }

kprobe:tcp_sendmsg
{
  $sk = (struct sock *)arg0;
  if ($sk->__sk_common.skc_num == $1) { $tp = (struct tcp_sock *)arg0; @ssk[tid] = arg0; @sws[tid] = $tp->write_seq; }
}
kretprobe:tcp_sendmsg
/@ssk[tid] != 0/
{
  $sk = (struct sock *)@ssk[tid]; $tp = (struct tcp_sock *)@ssk[tid];
  printf("SEND %llu %d %u %u %u\n", nsecs, tid, bswap($sk->__sk_common.skc_dport), @sws[tid], $tp->write_seq);
  delete(@ssk[tid]); delete(@sws[tid]);
}
kprobe:tcp_add_backlog
{
  $sk = (struct sock *)arg0;
  if ($sk->__sk_common.skc_num == $1) { printf("BKLG %llu %d %u\n", nsecs, tid, bswap($sk->__sk_common.skc_dport)); }
}
kprobe:__release_sock
{
  $sk = (struct sock *)arg0;
  if ($sk->__sk_common.skc_num == $1) { printf("RELS %llu %d %u\n", nsecs, tid, bswap($sk->__sk_common.skc_dport)); @rel[tid] = 1; }
}
kretprobe:__release_sock
/@rel[tid] != 0/
{
  printf("RELE %llu %d\n", nsecs, tid); delete(@rel[tid]);
}
kprobe:tcp_reno_cong_avoid
{
  $sk = (struct sock *)arg0;
  if ($sk->__sk_common.skc_num == $1) {
    $tp = (struct tcp_sock *)arg0;
    printf("RENO %llu %d %u %u %u %u %u %u %u %u\n", nsecs, tid, bswap($sk->__sk_common.skc_dport), arg1, arg2,
           $tp->snd_cwnd, $tp->snd_ssthresh, $tp->packets_out, $tp->max_packets_out, $tp->is_cwnd_limited);
  }
}
kprobe:tcp_slow_start
{
  $tp = (struct tcp_sock *)arg0;
  if ($tp->inet_conn.icsk_inet.sk.__sk_common.skc_num == $1) {
    printf("SS %llu %d %u %u %u %u\n", nsecs, tid, bswap($tp->inet_conn.icsk_inet.sk.__sk_common.skc_dport), arg1, $tp->snd_cwnd, $tp->snd_ssthresh);
  }
}
END { clear(@ssk); clear(@sws); clear(@rel); }
