#!/usr/bin/env bpftrace
/*
 * ticket_backlog.bt - are the acknowledgments of the session ticket deferred because the application owns the socket?
 *
 * While the server's tcp_sendmsg() holds the socket lock, arriving ACKs are queued by tcp_add_backlog() and processed afterwards by
 * release_sock() -> __release_sock(), still inside the call.
 *
 *   sudo bpftrace -q ticket_backlog.bt 4433 > tag.bpf.txt        ($1 = port of the server; trace_run.py starts it when PQC_BPF names this file)
 *
 * Output lines (nsecs = CLOCK_MONOTONIC; tid = kernel thread):
 *   SEND ns tid dport write_seq_before write_seq_after   return of tcp_sendmsg() (it wrote the bytes (before, after])
 *   BKLG ns tid dport                                    entry of tcp_add_backlog(): a segment found the socket owned by the application
 *   RELS ns tid dport / RELE ns tid                      entry / return of __release_sock(): the backlog is processed in between
 *   RENO ns tid dport ack acked cwnd ssthresh packets_out max_packets_out is_cwnd_limited   entry of tcp_reno_cong_avoid()
 *   SS   ns tid dport acked cwnd ssthresh                entry of tcp_slow_start()
 * analyze_backlog.py joins them: a RENO event of the same thread between RELS and RELE was processed from the backlog.
 */
BEGIN { printf("READY\n"); }

kprobe:tcp_sendmsg
{
  $sk = (struct sock *)arg0;
  if ($sk->__sk_common.skc_num == $1) { $tp = (struct tcp_sock *)arg0; @ssk[tid] = arg0; @sws[tid] = $tp->write_seq; }
}
kretprobe:tcp_sendmsg
/@ssk[tid] != 0/
{
  $sk = (struct sock *)@ssk[tid]; $tp = (struct tcp_sock *)@ssk[tid];
  printf("SEND %llu %d %u %u %u\n", nsecs, tid, bswap($sk->__sk_common.skc_dport), @sws[tid], $tp->write_seq);
  delete(@ssk[tid]); delete(@sws[tid]);
}
kprobe:tcp_add_backlog
{
  $sk = (struct sock *)arg0;
  if ($sk->__sk_common.skc_num == $1) { printf("BKLG %llu %d %u\n", nsecs, tid, bswap($sk->__sk_common.skc_dport)); }
}
kprobe:__release_sock
{
  $sk = (struct sock *)arg0;
  if ($sk->__sk_common.skc_num == $1) { printf("RELS %llu %d %u\n", nsecs, tid, bswap($sk->__sk_common.skc_dport)); @rel[tid] = 1; }
}
kretprobe:__release_sock
/@rel[tid] != 0/
{
  printf("RELE %llu %d\n", nsecs, tid); delete(@rel[tid]);
}
kprobe:tcp_reno_cong_avoid
{
  $sk = (struct sock *)arg0;
  if ($sk->__sk_common.skc_num == $1) {
    $tp = (struct tcp_sock *)arg0;
    printf("RENO %llu %d %u %u %u %u %u %u %u %u\n", nsecs, tid, bswap($sk->__sk_common.skc_dport), arg1, arg2,
           $tp->snd_cwnd, $tp->snd_ssthresh, $tp->packets_out, $tp->max_packets_out, $tp->is_cwnd_limited);
  }
}
kprobe:tcp_slow_start
{
  $tp = (struct tcp_sock *)arg0;
  if ($tp->inet_conn.icsk_inet.sk.__sk_common.skc_num == $1) {
    printf("SS %llu %d %u %u %u %u\n", nsecs, tid, bswap($tp->inet_conn.icsk_inet.sk.__sk_common.skc_dport), arg1, $tp->snd_cwnd, $tp->snd_ssthresh);
  }
}
END { clear(@ssk); clear(@sws); clear(@rel); }
